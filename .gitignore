# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---------- 虚拟环境 ----------
.venv/
venv/
env/

# ---------- 大体积数据缓存（可用 python run.py update 重新生成） ----------
